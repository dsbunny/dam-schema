		"@dsbunny/webhook-schema": "github:dsbunny/webhook-schema#de1d05d",
		"typescript": "^5.9.3",
		"zod": "^4.3.6"
	},
	"peerDependencies": {
		"@dsbunny/error-schema": "github:dsbunny/error-schema",
		"@dsbunny/metadata-schema": "github:dsbunny/metadata-schema",
		"@dsbunny/robust-task-schema": "github:dsbunny/robust-task-schema",
		"@dsbunny/webhook-schema": "github:dsbunny/webhook-schema",
		"zod": "^4.3.0"
	}
