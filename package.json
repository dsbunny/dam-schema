{
	"name": "@dsbunny/dam-schema",
	"version": "17.0.16",
	"description": "Schema for the DAM",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"author": "Steve-o <fnjordy@gmail.com>",
	"license": "MIT",
	"private": false,
	"allowScripts": {
		"@dsbunny/error-schema": true,
		"@dsbunny/metadata-schema": true,
		"@dsbunny/robust-task-schema": true,
		"@dsbunny/webhook-schema": true
	},
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist node_modules package-lock.json",
		"pull:upstream": "./scripts/pull-upstream.sh",
