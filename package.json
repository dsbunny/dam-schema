		"@dsbunny/robust-task-schema": "github:dsbunny/robust-task-schema#a383eeb",
		"@dsbunny/webhook-schema": "github:dsbunny/webhook-schema#f6b8e49",
		"@dsbunny/zod-registry": "github:dsbunny/zod-registry#35c7ef6",
		"typescript": "^5.9.3",
		"zod": "^4.3.6"
	},
	"peerDependencies": {
		"@dsbunny/error-schema": "github:dsbunny/error-schema",
		"@dsbunny/metadata-schema": "github:dsbunny/metadata-schema",
		"@dsbunny/net-schema": "github:dsbunny/net-schema",
